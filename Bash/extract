#!/bin/bash

count=0
failed=0
recursive=false
verbose=false

# nullglob: an empty directory expands to nothing (not a literal "*")
# dotglob:  "*" also matches hidden files
shopt -s nullglob dotglob

# Print the help message
usage() {
        cat <<EOF
Usage: ${0##*/} [-h] [-r] [-v] file [file...]
  -v  verbose: print each file decompressed, warn for each file NOT decompressed
  -r  recursive: traverse directories recursively and unpack each file
  -h  show this help
Prints the number of archives decompressed.
Exit code is the number of files NOT decompressed (capped at 255).
EOF
}

# Map each compression method to its extract command.
# Format: "pattern in file output|kind|command"
#   pipe = command reads stdin and writes stdout (result replaces the original file)
#   dir  = command extracts into the current directory
# Order: most specific first. To add a format, add one line.
METHODS=(
    "gzip compressed data|pipe|gunzip -c"
    "bzip2 compressed data|pipe|bunzip2 -c"
    "Zip archive data|dir|unzip -o -q"
    "compress'd data|pipe|uncompress -c"
)

# Prints "kind|command" for the file, or returns 1 if it is not a known archive.
get_method() {
        local ftype entry pattern rest
        ftype=$(file -b -- "$1")

        for entry in "${METHODS[@]}"; do
                pattern="${entry%%|*}"
                rest="${entry#*|}"
                if [[ "$ftype" == *"$pattern"* ]]; then
                        echo "$rest"
                        return 0
                fi
        done
        return 1
}

# Receives a file and its method ("kind|command") and extracts the file.
extract_file() {
        local target="$1" method="$2"
        local kind="${method%%|*}" cmd_str="${method#*|}"
        local dir base tmp
        local -a cmd
        dir=$(dirname -- "$target")
        base=$(basename -- "$target")
        read -ra cmd <<< "$cmd_str"

        # dir: the tool extracts the archive by itself, so just run it in the file's directory
        if [[ "$kind" == "dir" ]]; then
                (cd "$dir" && "${cmd[@]}" "./$base")

        # pipe: the tool writes to stdout, so write to a temp file in the same directory
        # and then replace the original file (the file's suffix does not matter)
        elif [[ "$kind" == "pipe" ]]; then
                tmp=$(mktemp -- "$dir/.extract.XXXXXX") || return 1
                if "${cmd[@]}" < "$target" > "$tmp"; then
                        mv -f -- "$tmp" "$target"
                else
                        rm -f -- "$tmp"
                        return 1
                fi
        fi
}

# Receives a path: if it is a directory, unpack what is inside it
# (subdirectories only when recursive is true); if it is a file, unpack it.
unpack_path() {
        local path="${1%/}" item method

        # Enter real directories only; skip symbolic links to avoid loops
        # and leaving the requested tree
        if [[ -d "$path" && ! -L "$path" ]]; then
                for item in "$path"/*; do
                        if [[ -d "$item" && "$recursive" == false ]]; then
                                continue
                        fi
                        unpack_path "$item"
                done
        elif [[ -f "$path" ]]; then
                if method=$(get_method "$path") && extract_file "$path" "$method"; then
                        count=$((count + 1))
                        [[ "$verbose" == true ]] && echo "extracted: $path"
                else
                        failed=$((failed + 1))
                        [[ "$verbose" == true ]] && echo "Warning: $path was not decompressed" >&2
                fi
        fi
}

# Parse the options: -h (help), -r (recursive), -v (verbose).
# An unknown option prints the usage to stderr and exits with 1.
while getopts "hrv" opt; do
        case "$opt" in
                h) usage; exit 0 ;;
                r) recursive=true ;;
                v) verbose=true ;;
                *) usage >&2; exit 1 ;;
        esac
done
shift $((OPTIND - 1))

# At least one file or directory is required, otherwise print the usage and exit with 1
if [[ $# -eq 0 ]]; then
        usage >&2
        exit 1
fi

# Go over every argument: unpack it if it exists, otherwise count it as not decompressed
for file in "$@"; do
        if [[ -e "$file" ]]; then
                unpack_path "$file"
        else
                failed=$((failed + 1))
                [[ "$verbose" == true ]] && echo "Warning: $file does not exist" >&2
        fi
done

echo "Decompressed $count archive(s)"
(( failed > 255 )) && failed=255
exit "$failed"
